# Copy this to .env and fill in your SMTP credentials
# The server will automatically use SMTP if these are set

# Proton Mail (uses SSL on port 465):
# HUB_SMTP_HOST=mail.proton.me
# HUB_SMTP_PORT=465
# HUB_SMTP_SSL=true
# HUB_SMTP_USER=your-username@proton.me
# HUB_SMTP_PASS=your-password
# HUB_SMTP_FROM=your-username@proton.me

# Gmail (uses STARTTLS on port 587):
# HUB_SMTP_HOST=smtp.gmail.com
# HUB_SMTP_PORT=587
# HUB_SMTP_SSL=false
# HUB_SMTP_USER=your-email@gmail.com
# HUB_SMTP_PASS=your-16-char-app-password
# HUB_SMTP_FROM=your-email@gmail.com

# Outlook/Office365 example:
# HUB_SMTP_HOST=smtp.office365.com
# HUB_SMTP_PORT=587
# HUB_SMTP_SSL=false
# HUB_SMTP_USER=your-email@outlook.com
# HUB_SMTP_PASS=your-password
# HUB_SMTP_FROM=your-email@outlook.com

# Custom SMTP:
HUB_SMTP_HOST=
HUB_SMTP_PORT=587
HUB_SMTP_SSL=false
HUB_SMTP_USER=
HUB_SMTP_PASS=
HUB_SMTP_FROM=